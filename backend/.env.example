# Copy to backend/.env and fill in real values. Never commit .env.
# Pydantic Settings (backend/app/core/config.py) reads these from the environment.

PROJECT_NAME="Remotion SaaS"
API_V1_STR="/api/v1"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me-generate-a-random-64-char-token"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="remotion_saas"
# Full connection URL takes precedence over the POSTGRES_* parts above.
# SQLALCHEMY_DATABASE_URI="postgresql://user:password@localhost:5432/remotion_saas"

# Optional third-party keys (leave blank if unused)
OPENAI_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
