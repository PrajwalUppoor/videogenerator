{
  "name": "video-engine",
  "version": "1.0.0",
  "description": "Remotion video engine for SaaS",
  "main": "src/index.ts",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion bundle src/index.ts out/bundle.js",
    "render": "remotion render src/index.ts Explainer out.mp4",
    "lambda:deploy": "remotion lambda functions deploy --region=us-east-1",
    "lambda:site": "remotion lambda sites create src/index.ts --site-name=remotion-saas --region=us-east-1",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.410",
    "@remotion/media": "^4.0.410",
    "@remotion/player": "^4.0.410",
    "@remotion/renderer": "^4.0.410",
    "@remotion/transitions": "^4.0.410",
    "@remotion/zod-types": "^4.0.410",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "remotion": "^4.0.410",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
